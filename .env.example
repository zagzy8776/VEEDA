# Frontend env — copy to .env and fill in values
VITE_API_URL="https://your-render-service.onrender.com"
VITE_VEDA_API_KEY="your-secret-api-key"
VITE_EMERGENCY_NUMBER="112"

# Optional: only needed for advanced staff builds
# VITE_ENABLE_CLINICIAN_ROLES=true

# Backend environment (set on Render — not in the frontend)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.7-flash"
GEOAPIFY_API_KEY="optional-for-geocoding-and-weather"
MAPBOX_TOKEN="optional"
VEDA_API_KEY="your-secret-api-key"
FRONTEND_URL="https://your-frontend.example.com"
