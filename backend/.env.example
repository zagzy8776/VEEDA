DATABASE_URL="postgresql://neondb_owner:<password>@ep-fancy-queen-a2gams03-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
GEOAPIFY_API_KEY="your-geoapify-api-key"
MAPBOX_TOKEN="your-mapbox-token"
EMERGENCY_NUMBER="112"
# Path to a clinician-reviewed referral band pack (JSON). Required in production;
# without it the referral engine fails safe and returns "unavailable".
REFERRAL_PACK_PATH=""
# Comma-separated browser origins allowed to call the API.
FRONTEND_URL="https://your-vercel-app.vercel.app"
BACKEND_URL="https://your-render-service.onrender.com"
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
PORT=10000
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
DEFAULT_TENANT_ID=default
ENABLE_PROXY_DEBUG=false

# AI providers (server-side only). The chat tries each provider in order and
# uses the first that answers, so one dead or rate-limited key never takes the
# conversation down. If they all fail, the app's own local dialogue reply is
# returned instead, so VEEDA always responds.
CEREBRAS_API_KEY="your-cerebras-api-key"
CEREBRAS_MODEL="gpt-oss-120b"
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"
# Set a separately verified image model; the text model is not assumed multimodal.
# GROQ_VISION_MODEL="qwen/qwen3.8-27b"

# Native Gemini generateContent adapter (server-side key only).
# GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_VISION_MODEL="gemini-2.5-flash"

# Optional extra OpenAI-compatible fallbacks — set a key to enable one.
# OPENAI_API_KEY="sk-your-openai-key-here"
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1/chat/completions"
# OPENROUTER_API_KEY="sk-or-your-openrouter-key"
# OPENROUTER_MODEL="openai/gpt-oss-120b"
# OPENROUTER_VISION_MODEL="google/gemini-2.5-flash"

# OpenAI-compatible or Gemini-compatible self-hosted endpoint. Capabilities are
# explicit and are never inferred from the model name.
# SELF_HOSTED_BASE_URL="https://inference.example/v1/chat/completions"
# SELF_HOSTED_API_KEY="server-only-key"
# SELF_HOSTED_MODEL="local-text-model"
# SELF_HOSTED_VISION_MODEL="local-vision-model"
# SELF_HOSTED_API_FORMAT="openai"
# SELF_HOSTED_CAPABILITIES="text,image"

# Optional per-provider routing controls: lower priority runs first.
# GEMINI_PRIORITY=10
# GROQ_PRIORITY=20
# OPENROUTER_PRIORITY=30
# OPENAI_PRIORITY=40
# SELF_HOSTED_PRIORITY=50
# Each provider also accepts *_TIMEOUT_MS and *_RPM limits.

# Medicine knowledge uses public OpenFDA + NIH RxNorm (no key required).
# Optional Nigerian / official regulatory verification pathway (pluggable):
# NAFDAC_VERIFY_URL="https://partner.example/verify"
# REGULATORY_VERIFY_URL="https://partner.example/verify"
# REGULATORY_AUTHORITY_NAME="NAFDAC"
