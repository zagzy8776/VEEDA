DATABASE_URL="postgresql://neondb_owner:<password>@ep-fancy-queen-a2gams03-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
GEOAPIFY_API_KEY="your-geoapify-api-key"
MAPBOX_TOKEN="your-mapbox-token"
EMERGENCY_NUMBER="112"
# Path to a clinician-reviewed referral band pack (JSON). Required in production;
# without it the referral engine fails safe and returns "unavailable".
REFERRAL_PACK_PATH=""
# Local/test use only. Never enable in production; sample content is not clinically reviewed.
ALLOW_SAMPLE_CLINICAL_PACKS="false"
# Comma-separated browser origins allowed to call the API.
FRONTEND_URL="https://your-vercel-app.vercel.app"
BACKEND_URL="https://your-render-service.onrender.com"
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
PORT=10000
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
DEFAULT_TENANT_ID=default
ENABLE_PROXY_DEBUG=false

# AI providers (server-side only). The chat tries each provider in priority order
# and uses the first that answers. If they all fail, the app's local dialogue
# reply is returned so VEEDA always responds.
#
# Recommended free path right now:
#   OPENROUTER_API_KEY=sk-or-...
#   OPENROUTER_MODEL=openrouter/free          # or a specific free model
#   # OPENROUTER_MODEL=x-ai/grok-3-mini-beta  # if you want Grok via OpenRouter
#
# Free OpenRouter models are capped (~50 req/day until you top up $10).

CEREBRAS_API_KEY="your-cerebras-api-key"
CEREBRAS_MODEL="gpt-oss-120b"
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"
# GROQ_VISION_MODEL="qwen/qwen3.8-27b"

# Native Gemini generateContent adapter (server-side key only).
# GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_VISION_MODEL="gemini-2.5-flash"

# OpenRouter (supports free models + Grok / xAI models)
OPENROUTER_API_KEY="sk-or-your-openrouter-key"
# Default is openrouter/free (routes to a free model). Override for quality:
# OPENROUTER_MODEL="openrouter/free"
# OPENROUTER_MODEL="x-ai/grok-3-mini-beta"
# OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning:free"
# OPENROUTER_VISION_MODEL="nvidia/nemotron-3.5-super-vl:free"

# Optional paid OpenAI
# OPENAI_API_KEY="sk-your-openai-key-here"
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1/chat/completions"

# OpenAI-compatible or Gemini-compatible self-hosted endpoint.
# SELF_HOSTED_BASE_URL="https://inference.example/v1/chat/completions"
# SELF_HOSTED_API_KEY="server-only-key"
# SELF_HOSTED_MODEL="local-text-model"
# SELF_HOSTED_VISION_MODEL="local-vision-model"
# SELF_HOSTED_API_FORMAT="openai"
# SELF_HOSTED_CAPABILITIES="text,image"

# Optional per-provider routing controls: lower priority runs first.
# GEMINI_PRIORITY=10
# OPENROUTER_PRIORITY=15
# GROQ_PRIORITY=20
# OPENAI_PRIORITY=40
# SELF_HOSTED_PRIORITY=50
# Each provider also accepts *_TIMEOUT_MS and *_RPM limits.

# Medicine knowledge uses public OpenFDA + NIH RxNorm (no key required).
# Optional Nigerian / official regulatory verification pathway (pluggable):
# NAFDAC_VERIFY_URL="https://partner.example/verify"
# REGULATORY_VERIFY_URL="https://partner.example/verify"
# REGULATORY_AUTHORITY_NAME="NAFDAC"
