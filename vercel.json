{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://veeda.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://veeda.onrender.com/auth/:path*"
    }
  ]
}

